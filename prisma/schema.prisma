generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum CalendarProvider {
  NONE
  OUTLOOK
  GOOGLE
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum FlowStepType {
  FREE_CHOICE
  PRODUCT_SET
  LOCATIONS
  CATEGORIES
  SELLERS_AGENDA
  CONFIRMATION
}

enum AnalyticsEventType {
  NOT_FOUND_404
  FORM_SUBMIT_ERROR
  EMAIL_ERROR
  MAKE_ERROR
  FORM_SUBMIT_SUCCESS
}

model Entity {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  domain     String?
  logoUrl         String?    @db.Text
  introText       String?    @db.VarChar(500)
  emailExtraTxt   String?    @db.LongText
  primaryColor    String?    @db.VarChar(7)
  secondaryColor  String?    @db.VarChar(7)
  accentColor     String?    @db.VarChar(7)
  gtmId           String?    @db.VarChar(32)
  headerScripts   String?    @db.LongText
  footerScripts   String?    @db.LongText
  calendarProvider          CalendarProvider @default(NONE)
  calendarTimezone          String           @default("Europe/Brussels") @db.VarChar(64)
  outlookTenantId           String?          @db.VarChar(64)
  outlookClientId           String?          @db.VarChar(64)
  outlookClientSecretEnc    String?          @db.Text
  googleClientEmail         String?          @db.VarChar(255)
  googlePrivateKeyEnc       String?          @db.Text
  googleSubject             String?          @db.VarChar(255)
  active            Boolean  @default(true)
  maintenanceMode   Boolean  @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  users           UserEntity[]
  locations       Location[]
  sellers     Seller[]
  categories  Category[]
  flows           Flow[]
  contentBlocks   ContentBlock[]
  productSets     ProductSet[]    @relation("ProductSetEntities")
  analyticsEvents AnalyticsEvent[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  role           Role
  entities       UserEntity[]
  lastLoggedInAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model UserEntity {
  userId    String
  entityId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([userId, entityId])
  @@index([entityId])
}

model ProductSet {
  id        String           @id @default(cuid())
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  products  ProductSetItem[]
  entities  Entity[]         @relation("ProductSetEntities")
}

model ProductSetItem {
  id           String     @id @default(cuid())
  name         String
  photoUrl     String
  sortOrder    Int        @default(0)
  productSetId String
  productSet   ProductSet @relation(fields: [productSetId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([productSetId])
}

model Location {
  id             String           @id @default(cuid())
  name           String
  imageUrl       String?          @db.Text
  address        String           @db.VarChar(255)
  googleMapsUrl  String           @db.Text
  phone          String           @db.VarChar(50)
  email          String
  permalink      String
  entityId       String
  entity         Entity           @relation(fields: [entityId], references: [id], onDelete: Cascade)
  schedules      SellerSchedule[]
  primarySellers Seller[]         @relation("SellerPrimaryLocation")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([entityId, permalink])
  @@index([entityId])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String?  @db.Text
  slug      String
  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  sellers   Seller[] @relation("SellerToCategory")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, slug])
  @@index([entityId])
}

model Seller {
  id                String           @id @default(cuid())
  name              String
  email             String
  imageUrl          String           @db.Text
  active            Boolean          @default(true)
  entityId          String
  entity            Entity           @relation(fields: [entityId], references: [id], onDelete: Cascade)
  primaryLocationId String?
  primaryLocation   Location?        @relation("SellerPrimaryLocation", fields: [primaryLocationId], references: [id], onDelete: SetNull)
  schedules         SellerSchedule[]
  categories        Category[]       @relation("SellerToCategory")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([entityId])
  @@index([primaryLocationId])
}

model SellerSchedule {
  id         String   @id @default(cuid())
  weekday    Weekday
  startTime  String
  endTime    String
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sellerId, weekday])
  @@index([sellerId])
  @@index([locationId])
}

model Flow {
  id            String     @id @default(cuid())
  name          String
  slug          String
  featuredImage String?    @db.Text
  active        Boolean    @default(true)
  sortOrder     Int        @default(0)
  entityId      String
  entity        Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  steps         FlowStep[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([entityId, slug])
  @@index([entityId])
  @@index([entityId, sortOrder])
}

model FlowStep {
  id            String               @id @default(cuid())
  flowId        String
  flow          Flow                 @relation(fields: [flowId], references: [id], onDelete: Cascade)
  type          FlowStepType
  sortOrder     Int                  @default(0)
  config        Json
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  contentBlocks ContentBlockStep[]

  @@index([flowId])
}

model ContentBlock {
  id        String             @id @default(cuid())
  title     String             @db.VarChar(200)
  text      String             @db.Text
  /// Array of { label: string, url: string }
  buttons   Json               @default("[]")
  active    Boolean            @default(true)
  sortOrder Int                @default(0)
  entityId  String
  entity    Entity             @relation(fields: [entityId], references: [id], onDelete: Cascade)
  steps     ContentBlockStep[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([entityId, sortOrder])
}

model ContentBlockStep {
  contentBlockId String
  flowStepId     String
  contentBlock   ContentBlock @relation(fields: [contentBlockId], references: [id], onDelete: Cascade)
  flowStep       FlowStep     @relation(fields: [flowStepId], references: [id], onDelete: Cascade)

  @@id([contentBlockId, flowStepId])
  @@index([flowStepId])
}

model AnalyticsEvent {
  id         String             @id @default(cuid())
  type       AnalyticsEventType
  entityId   String?
  entity     Entity?            @relation(fields: [entityId], references: [id], onDelete: SetNull)
  sellerId   String?
  locationId String?
  categoryId String?
  message    String?            @db.VarChar(500)
  createdAt  DateTime           @default(now())

  @@index([type, createdAt])
  @@index([entityId, createdAt])
  @@index([createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String
  userRole   Role
  action     String   @db.VarChar(32)
  summary    String   @db.VarChar(500)
  detail     String?  @db.VarChar(500)
  entityId   String?
  entityName String?  @db.VarChar(255)
  entityIds  String?  @db.VarChar(1000)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entityId, createdAt])
}
