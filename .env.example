# MySQL connection string
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/booky_cms"

PORT=3000
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Used by prisma/seed.ts
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Optional demo tenant + entity admin (set to "true" to create)
SEED_DEMO="false"
SEED_DEMO_ENTITY_NAME="Demo Dealer"
SEED_DEMO_ENTITY_SLUG="demo-dealer"
SEED_DEMO_ADMIN_EMAIL="dealer@example.com"
SEED_DEMO_ADMIN_PASSWORD="ChangeMe123!"

# Microsoft Graph (app-only) for seller calendar connectivity
# Needs application permission: Calendars.Read or Schedule.Read.All (admin consent)
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_TIMEZONE="Europe/Brussels"

# SendGrid (booking confirmation mails)
# From-adres = [From-adres local]@[entity domain] (default local: booky); From name via Domeininstellingen
SENDGRID_API_KEY=""
SENDGRID_BOOKING_TEMPLATE_ID=""
SENDGRID_SELLER_BOOKING_TEMPLATE_ID="d-c3d7cfbcee154900bf95512812e7edf0"
PUBLIC_BASE_URL=""
# Optional: where to send the browser after Google OAuth (defaults to PUBLIC_BASE_URL)
ADMIN_PUBLIC_URL=""

# Google Calendar — shared Booky callback (customers paste this into their Google Cloud OAuth client).
# Client ID/secret are entered per entity under Integraties.
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/google-oauth/callback"

# reCAPTCHA v3 (classic siteverify)
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_MIN_SCORE=0.5
